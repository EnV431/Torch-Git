  m_Name: HungryBandits
  m_EditorClassIdentifier: 
  IncidentDetails:
    isNegative: 1
    incidentName: Hungry Bandits
    chanceToHappen: 40
    incidentDescription: 'After reaching your destination and setting up camp for
      the night, your caravan is awoken by the sounds of heavy footsteps, harsh voices
      and the sound of weapons being unsheathed.  It seems a small group of bandits
      have caught you by surprise. You are unable to reasonably mount a defense with
      blades quite literally already at your throats. Thankfully they don''t want
      blood, and simply begin to ransack your food supplies.   Your caravan watches
      on impotently as sacks and barrels disappear into the woods carried by the
      bandits.  After the men and women of ill morals are gone, the caravan is left
      on high alert and nobody gets much rest.   Unfortunately the damage is already
      done.  You lose 30 food '
    incidentTypeId: 1
    incidentImage: {fileID: 0}
  AttackerDetails:
    isAttacker: 1
    attackPower: 30
    attackerEvilLevel: 1
  resourceChangesArray:
  - resourceType: 0
    amountToChange: -40
